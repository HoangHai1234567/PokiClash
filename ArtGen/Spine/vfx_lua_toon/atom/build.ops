bone.add mieng parent=root x=-300 y=130
bone.add dan parent=root x=-300 y=130
bone.add dich parent=root x=290 y=95
bone.add nam parent=root x=290 y=0
bone.add mieng_tia parent=mieng x=60 y=0 rot=-90
vfx.art than kind=spark palette=fire size=22 seed=3
slot.add phun bone=mieng
att.region phun phun_lua image=phun_lua_00 x=294.0 y=25.0 use=false
att.seq phun phun_lua prefix=phun_lua_ count=38 setup=0
slot.add nho bone=mieng
att.region nho phun_nho image=phun_nho_00 x=140.0 y=6.0 use=false
att.seq nho phun_nho prefix=phun_nho_ count=12 setup=0
slot.add cau bone=dan
att.region cau cau_lua image=cau_lua_00 x=-62.0 y=3.0 use=false
att.seq cau cau_lua prefix=cau_lua_ count=12 setup=0
slot.add ten bone=dan
att.region ten muiten image=muiten_00 x=-148.0 y=0.0 use=false
att.seq ten muiten prefix=muiten_ count=12 setup=0
slot.add no bone=dich
att.region no no_trung image=no_trung_00 x=0.0 y=10.0 use=false
att.seq no no_trung prefix=no_trung_ count=18 setup=0
slot.add nam bone=nam
att.region nam no_nam image=no_nam_00 x=0.0 y=190.0 use=false
att.seq nam no_nam prefix=no_nam_ count=42 setup=0
anim.add phun_lua dur=1.683
key phun_lua phun.attachment 0.000:phun_lua 1.583:-
key phun_lua phun.seq 0.000:once,0,0.04167
vfx.burst phun_lua image=than bone=mieng_tia count=14 t=0.08 dur=0.7 speed=520 spread=40 gravity=-60 spin=180 seed=5
anim.add phun_nho dur=1.0 loop=true
key phun_nho nho.attachment 0.000:phun_nho
key phun_nho nho.seq 0.000:loop,0,0.04167
anim.add cau_lua dur=1.350
key cau_lua cau.attachment 0.000:cau_lua 0.550:-
key cau_lua cau.seq 0.000:loop,0,0.04167
key cau_lua dan.translate 0:0,0:easeIn 0.550:590,-35
key cau_lua dan.scale 0:0.35,0.35:backOut 0.12:1,1 0.550:1.1,1.1
key cau_lua no.attachment 0.550:no_trung 1.300:-
key cau_lua no.seq 0.550:once,0,0.04167
vfx.shake cau_lua bone=dich t=0.550 dur=0.25 amp=5 freq=30 seed=2
anim.add mui_ten dur=1.120
key mui_ten ten.attachment 0.000:muiten 0.320:-
key mui_ten ten.seq 0.000:loop,0,0.04167
key mui_ten dan.translate 0:-40,0:easeIn 0.320:590,-35
key mui_ten dan.scale 0:0.6,0.6:easeOut 0.06:1,1
key mui_ten no.attachment 0.320:no_trung 1.070:-
key mui_ten no.seq 0.320:once,0,0.04167
key mui_ten dich.scale 0:1,1 0.320:0.7,0.7 1.070:0.7,0.7
anim.add no_trung dur=0.850
key no_trung no.attachment 0.000:no_trung 0.750:-
key no_trung no.seq 0.000:once,0,0.04167
anim.add no_nam dur=1.850
key no_nam nam.attachment 0.000:no_nam 1.750:-
key no_nam nam.seq 0.000:once,0,0.04167
vfx.shake no_nam bone=root t=0.04 dur=0.5 amp=8 freq=28 seed=4
