att.weights chan_t chan_t bones=dui_t,ong_t
part.add chan_p path=images/chan_p.png at=259.0,526.0 canvas=512,768 origin=256,709 bone=dui_p mesh=true
att.weights chan_p chan_p bones=dui_p,ong_p
part.add quan path=images/quan.png at=149.0,455.0 canvas=512,768 origin=256,709 bone=hip mesh=true
att.weights quan quan bones=hip,dui_t,dui_p
part.add ung_t path=images/ung_t.png at=115.0,593.0 canvas=512,768 origin=256,709 bone=ik_chan_t
part.add ung_p path=images/ung_p.png at=277.0,593.0 canvas=512,768 origin=256,709 bone=ik_chan_p
