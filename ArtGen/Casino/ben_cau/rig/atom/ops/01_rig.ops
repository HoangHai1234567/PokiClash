part.add dau path=images/dau.png at=122.0,47.0 canvas=512,768 origin=256,709 bone=dau
part.add toc_chom path=images/toc_chom.png at=206.5,26.0 canvas=512,768 origin=256,709 bone=chom
ik.add chan_t bones=dui_t,ong_t target=ik_chan_t bend=-
ik.add chan_p bones=dui_p,ong_p target=ik_chan_p bend=+
part.add dau_quay__dau path=images/dau_quay.png at=127.5,34.0 canvas=512,768 origin=256,709 bone=dau slot=dau
slot.set dau att=dau
slot.order can_cau to=front
