part.add can_cau path=images/can_cau.png at=269.5,-159.5 canvas=512,768 origin=256,709 bone=can1 mesh=true
att.weights can_cau can_cau bones=can1,can2,can3,can4
part.add tay_t path=images/tay_t.png at=142.5,302.0 canvas=512,768 origin=256,709 bone=nguc
part.add tay_p path=images/tay_p.png at=315.5,295.5 canvas=512,768 origin=256,709 bone=nguc
part.add than path=images/than.png at=198.0,285.0 canvas=512,768 origin=256,709 bone=nguc
